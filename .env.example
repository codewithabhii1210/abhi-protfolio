# Copy this file to server/.env, then fill in real values.
# NEVER commit server/.env — it is gitignored.

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio

# --- Auth ---
# Min 32 random chars. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# REQUIRED in production (Vercel). Without it only localhost:5173 is allowed,
# which breaks the contact form and admin login on your deployed site.
CLIENT_ORIGIN=http://localhost:5173

# --- Cloudinary (only needed for admin image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed credentials (only used by `npm run seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
